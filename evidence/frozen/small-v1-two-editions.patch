+void MainWindow::startGemm()
+{
+    QString state=Gemm::snapshot().value("status").toString();
+    if (Gemm::active() && (state=="running" || state=="preparing")) {
+        QMessageBox::information(this,QString::fromUtf8("矩阵演武"),QString::fromUtf8("请先完成或停止当前演武。")); return;
+    }
+    GemmDialog dialog(this);
+    if(dialog.exec()==QDialog::Accepted) launchGemm(dialog.input());
+}
+
+void MainWindow::launchGemm(const QJsonObject &input)
+{
+    Gemm::cancel();
+    if(server) {
+        foreach(Room *r,server->findChildren<Room *>()) {
+            if(r->getThread()) r->getThread()->wait();
+            r->wait();
+        }
+    }
+    QToolBar *old=findChild<QToolBar *>("gemmToolbar");
+    if(old) {removeToolBar(old);delete old;}
+    QToolBar *oldResults=findChild<QToolBar *>("gemmResults");
+    if(oldResults) {removeToolBar(oldResults);delete oldResults;}
+    if(scene && scene->inherits("RoomScene")) gotoStartScene();
+    QString error;if(!Gemm::configure(input,error)) {QMessageBox::warning(this,"GEMM",error);return;}
+    Config.GameMode="gemm";Config.RandomSeat=false;Config.Enable2ndGeneral=false;Config.EnableBasara=false;
+    Config.EnableHegemony=false;Config.EnableAI=true;Config.EnableCheat=false;Config.CountDownSeconds=0;
+    Config.AIDelay=0;Config.OriginAIDelay=0;Config.EnableLuckCard=false;
+    server=new Server(this);
+    if(!server->listen()) {QMessageBox::warning(this,"GEMM",QString::fromUtf8("本地端口被占用，无法启动牌桌。"));delete server;server=NULL;return;}
+    Config.HostAddress=QString("127.0.0.1:%1").arg(Config.ServerPort);
+    QToolBar *bar=new QToolBar(QString::fromUtf8("矩阵演武"),this);bar->setObjectName("gemmToolbar");
+    bar->setMovable(false);addToolBar(Qt::TopToolBarArea,bar);
+    QAction *pauseAction=bar->addAction(QString::fromUtf8("暂停"));pauseAction->setCheckable(true);
+    connect(pauseAction,&QAction::toggled,[pauseAction](bool p){Gemm::pause(p);pauseAction->setText(QString::fromUtf8(p?"继续":"暂停"));});
+    QAction *single=bar->addAction(QString::fromUtf8("单步"));
+    connect(single,&QAction::triggered,[pauseAction](){pauseAction->setChecked(true);Gemm::step();});
+    QComboBox *speedBox=new QComboBox(bar);
+    speedBox->addItems(QStringList()<<QString::fromUtf8("正常")<<QString::fromUtf8("加速")<<QString::fromUtf8("极速 / 无动画"));
+    speedBox->setCurrentIndex(input.value("speed").toInt());bar->addWidget(speedBox);
+    connect(speedBox,static_cast<void(QComboBox::*)(int)>(&QComboBox::currentIndexChanged),[](int n){Gemm::setSpeed(n);});
+    QAction *stop=bar->addAction(QString::fromUtf8("停止"));connect(stop,&QAction::triggered,[](){Gemm::cancel();});
+    QAction *again=bar->addAction(QString::fromUtf8("重播"));again->setEnabled(false);
+    connect(again,&QAction::triggered,[this,input](){launchGemm(input);});
+    QAction *newInput=bar->addAction(QString::fromUtf8("新矩阵"));newInput->setEnabled(false);
+    connect(newInput,SIGNAL(triggered()),this,SLOT(startGemm()));
+    QAction *save=bar->addAction(QString::fromUtf8("保存记录"));save->setEnabled(false);
+    connect(save,&QAction::triggered,[this]() {
+        QString directory=QCoreApplication::applicationDirPath()+"/records/"+Gemm::edition();
+        QDir().mkpath(directory);
+        QString suggested=directory+"/"+QDateTime::currentDateTime().toString("yyyyMMdd-HHmmss-zzz")+".json";
+        QString path=QFileDialog::getSaveFileName(this,QString::fromUtf8("保存计算记录"),suggested,"JSON (*.json)");
+        if(path.isEmpty())return;QSaveFile file(path);
+        if(!file.open(QIODevice::WriteOnly)) {QMessageBox::warning(this,"GEMM",file.errorString());return;}
+        file.write(QJsonDocument(Gemm::snapshot()).toJson());if(!file.commit()) QMessageBox::warning(this,"GEMM",file.errorString());
+    });
+    QToolBar *resultBar=new QToolBar(QString::fromUtf8("计算结果"),this);
+    resultBar->setObjectName("gemmResults");resultBar->setMovable(false);addToolBar(Qt::BottomToolBarArea,resultBar);
+    QLabel *status=new QLabel(resultBar);resultBar->addWidget(status);
+    QList<QPushButton *> results;
+    for(int i=0;i<input.value("A").toArray().size();++i) for(int j=0;j<input.value("B").toArray().first().toArray().size();++j) {
+        QPushButton *button=new QPushButton(QString("C%1%2=0").arg(i+1).arg(j+1),resultBar);resultBar->addWidget(button);results<<button;
+        connect(button,&QPushButton::clicked,[this,i,j](){
+            QString name;
+            foreach(QJsonValue v,Gemm::snapshot().value("initialPlayers").toArray()) {
+                QJsonObject o=v.toObject();if(o["label"].toString()==QString("C[%1,%2]").arg(i+1).arg(j+1)) name=o["id"].toString();
+            }
+            if(!name.isEmpty()) QMetaObject::invokeMethod(scene,"highlightGemmPlayer",Q_ARG(QString,name));
+        });
+    }
+    QTimer *timer=new QTimer(bar);
+    connect(timer,&QTimer::timeout,[this,status,again,newInput,save,pauseAction,single,stop,results,input,timer](){
+        QJsonObject r=Gemm::snapshot();QString state=r["status"].toString();
+        bool done=state=="complete" || state=="failed";
+        again->setEnabled(done);newInput->setEnabled(done);save->setEnabled(done);
+        pauseAction->setEnabled(!done);single->setEnabled(!done);stop->setEnabled(!done);
+        view->setUpdatesEnabled(!(Gemm::speed()==2 && state=="running" && !r["paused"].toBool()));
+        QString text=QString::fromUtf8("  %1/%2 杀 · %3 ms  ").arg(r["completed"].toInt()).arg(r["tasks"].toInt()).arg(r["engineMs"].toDouble(),0,'f',2);
+        if(state=="complete")text+=QString::fromUtf8("已完成  ");
+        if(state=="failed")text+=QString::fromUtf8("已停止：")+r["error"].toString();
+        status->setText(text);
+        QJsonArray c=r["C"].toArray();int idx=0;
+        for(int i=0;i<c.size();++i) for(int j=0;j<c[i].toArray().size();++j) {
+            if(idx<results.size())results[idx++]->setText(QString("C%1%2=%3").arg(i+1).arg(j+1).arg(c[i].toArray()[j].toInt()));
+        }
+        if(done) {view->viewport()->update();timer->stop();}
+    });
+    timer->start(100);startConnection();
+}
